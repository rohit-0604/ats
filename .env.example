# ATS v8 — Environment Variables
# Copy to .env and fill in your API keys.
# NEVER commit .env to Git.

# ─── Required (3 providers) ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Free at: console.groq.com → API Keys → Create API Key  (email only, no card)
# Tier 1 (classification), Tier 3 (codegen+repair), fallbacks

GEMINI_API_KEY=AIza...
# Free at: aistudio.google.com → Get API key → Create API key in new project
# Tier 2 (extraction) — 1M context window
# IMPORTANT: gemini-2.0-flash RETIRED March 3 2026. Code now uses gemini-2.5-flash.
# RPD limits not confirmed from official docs — verify at:
#   https://ai.google.dev/gemini-api/docs/rate-limits

OPENROUTER_API_KEY=sk-or-...
# Free at: openrouter.ai → Account → Keys → Create key  (no card for :free models)
# Tier 4 (DeepSeek R1 reasoning), Tier 3 fallback

# ─── Optional fallback providers ─────────────────────────────────────────────
CEREBRAS_API_KEY=csk-...
# Free at: cloud.cerebras.ai → API Keys
# 1,000,000 tokens/day overflow for Tier 1 and Tier 3

MISTRAL_API_KEY=...
# Free at: console.mistral.ai (phone number required)
# 1 billion tokens/month — monthly overflow fallback

# ─── Pipeline settings (defaults are correct) ────────────────────────────────
TARGET_COVERAGE=85
TARGET_EXEC=80
MAX_LOOPS=8
USE_ASYNC=true
ASYNC_CONCURRENCY=3

CHUNK_SIZE=4000
# CHUNK_OVERLAP is hardcoded to 0 in config.py — do not add it here.
# Any positive overlap causes systematic duplicate requirement extraction.

SELECTOR_MIN_SCORE=0.4
CRAWL_DEPTH=2

HITL_TIMEOUT_MINUTES=60
HITL_SERVER_PORT=9999

MEMORY_INJECTION_THRESHOLD=0.65
PROMPT_EVOLUTION_INTERVAL=3

LOG_LEVEL=INFO
